# Copy this file to .env and fill it in.
# Leave SNOWFLAKE_ACCOUNT empty to use the local DuckDB file instead of Snowflake.

# Account identifier, looks like ORGNAME-ACCOUNTNAME
# (run the last query in sql/00_snowflake_setup.sql, or Snowsight > account menu > Account details)
SNOWFLAKE_ACCOUNT=
SNOWFLAKE_USER=
# Programmatic access token (token_secret) from sql/00_snowflake_setup.sql
SNOWFLAKE_PAT=
SNOWFLAKE_ROLE=SHELFCAST_ROLE
SNOWFLAKE_WAREHOUSE=SHELFCAST_WH
SNOWFLAKE_DATABASE=SHELFCAST

# Optional: pick the Cortex model for the AI brief (otherwise a few common ones are tried)
# SHELFCAST_CORTEX_MODEL=llama3.3-70b
